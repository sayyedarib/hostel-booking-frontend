# Copy this file to `.env` and fill in your own values:
#
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real credentials.
#
# Only variables prefixed with NEXT_PUBLIC_ are sent to the browser. Everything
# else stays on the server. `pnpm check:env` fails the build if a server-only
# variable is ever read from client-reachable code.

# -----------------------------------------------------------------------------
# Database (Supabase Postgres) — used by Drizzle ORM and drizzle-kit migrations
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
#
# Prefer the connection *pooler* URI on the free tier: each serverless instance
# opens its own connection and the direct-connection limit is easy to exhaust.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# -----------------------------------------------------------------------------
# Supabase (browser client, SSR client, middleware, invoice PDF storage bucket)
# Supabase Dashboard → Project Settings → API
# The anon key is designed to be public and is protected by row-level security.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# -----------------------------------------------------------------------------
# Clerk authentication — Clerk Dashboard → API Keys
#
# Use a *development* instance (pk_test_/sk_test_) locally: Clerk refuses to
# serve production keys from localhost.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for /api/clerk/webhook (creates the local user record on
# user.created). Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — this app serves sign-in/sign-up at custom routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Email (Nodemailer over SMTP — smtpout.secureserver.net)
# Mailbox credentials used to send booking/payment confirmation emails.
# Optional: when unset, email sending is disabled rather than crashing.
# -----------------------------------------------------------------------------
EMAIL_USER=no-reply@yourdomain.com
EMAIL_PASSWORD=<your-email-password>

# -----------------------------------------------------------------------------
# App URLs
# NEXT_PUBLIC_APP_URL      — canonical base URL; drives metadata and the sitemap
# NEXT_PUBLIC_FRONTEND_URL — base URL for invoice/payment links and the page
#                            Puppeteer renders into the invoice PDF
# Both are http://localhost:3000 in local development.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DEPRECATED — read as a fallback by src/env.ts so existing deployments keep
# working. Rename these in your hosting provider and delete these lines.
#
#   NEXT_PUBLIC_DATABASE_URL        → DATABASE_URL
#   NEXT_PUBLIC_CLERK_WEBHOOK_SECRET → CLERK_WEBHOOK_SECRET
#   NEXT_PUBLIC_EMAIL_USR           → EMAIL_USER
#   NEXT_PUBLIC_EMAIL_PWD           → EMAIL_PASSWORD
#
# The NEXT_PUBLIC_ prefix publishes a value to the browser as soon as it is
# referenced from client code, so these names put secrets one import away from
# every visitor.
# -----------------------------------------------------------------------------
