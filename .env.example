# Copy this file to `.env.local` and fill in your own values:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored — never commit real credentials.
#
# NOTE: several server-only secrets below are prefixed with `NEXT_PUBLIC_`.
# That prefix exposes a variable to the browser whenever it is referenced from
# client-side code. They are currently only read on the server, but the names
# are kept as-is to match the existing code. Treat them as secrets.

# -----------------------------------------------------------------------------
# Database (Supabase Postgres) — used by Drizzle ORM and drizzle-kit migrations
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# -----------------------------------------------------------------------------
# Supabase (client, SSR client and middleware; also invoice PDF storage bucket)
# Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# -----------------------------------------------------------------------------
# Clerk authentication
# Clerk Dashboard → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for the /api/clerk/webhook endpoint (user.created sync).
# Clerk Dashboard → Webhooks → your endpoint → Signing Secret
NEXT_PUBLIC_CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — this app serves sign-in/sign-up at custom routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# Email (Nodemailer over SMTP — smtpout.secureserver.net)
# Mailbox credentials used to send booking/payment confirmation emails.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_EMAIL_USR=no-reply@yourdomain.com
NEXT_PUBLIC_EMAIL_PWD=<your-email-password>

# -----------------------------------------------------------------------------
# App URLs
# NEXT_PUBLIC_FRONTEND_URL — base URL used to build invoice/payment links and
#   the page that Puppeteer renders into the invoice PDF.
# NEXT_PUBLIC_APP_URL — base URL used by the absoluteUrl() helper.
# Both are http://localhost:3000 in local development.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
